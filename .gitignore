# Root tooling dependencies (each app ignores its own)
node_modules/

# OS files
.DS_Store
Thumbs.db

# Editors: share only the recommended extensions and workspace settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local values for Docker Compose (for example HERE_API_KEY)
.env
.env.production

# Terraform local credentials, state, and plans; commit the provider lockfile.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
*.pem
*.key
