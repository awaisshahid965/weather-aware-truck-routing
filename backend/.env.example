# Local development settings. Copy to .env: cp .env.example .env
# Production sets real environment variables; the container never reads .env.

# --- Django ---
DJANGO_DEBUG=true
# Required in production. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Transport security (defaults follow DJANGO_DEBUG) ---
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=3600
# Set to true only behind a TLS-terminating proxy that sets X-Forwarded-Proto.
# DJANGO_TRUST_X_FORWARDED_PROTO=false

# --- Logging ---
# LOG_LEVEL: DEBUG, INFO, WARNING or ERROR. LOG_FORMAT: text or json.
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Third-party providers ---
# HERE routing and geocoding key. Leave empty until the provider adapters exist.
HERE_API_KEY=
