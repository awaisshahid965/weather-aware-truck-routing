# Copy to .env.production on the VM; this file is not a credential store.
# A hostname only, without https:// or a path. Its DNS must point to the VM.
APP_DOMAIN=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Supply your HERE routing/geocoding API key on the VM.
HERE_API_KEY=
