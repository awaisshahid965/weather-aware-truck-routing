# Copy to .env.local for local development: cp .env.example .env.local
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time. Never put secrets here.

# Base URL of the Django API, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# MapLibre style JSON for the base map. OpenFreeMap needs no API key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
